---
import Base from '../layouts/Base.astro';
import BookButton from '../components/BookButton.astro';
import ApptOnly from '../components/ApptOnly.astro';
import { business as b } from '../data/business.js';
---
<Base
  title="Contact Us | Med Spa in San Clemente, CA"
  description="Skin Restore, 312 Avenida de la Estrella, San Clemente CA. Call (949) 545-7919 to book with a licensed esthetician."
>
  <section class="section page intro">
    <div class="intro__fig">
      <img
        src="/images/front-desk.jpg"
        alt="The reception desk at Skin Restore, San Clemente, with the Skin Restore logo on the wall"
        width="1200" height="1600" fetchpriority="high"
      />
    </div>
    <div class="intro__text prose">
      <h1>Visit Skin Restore</h1>
      <p class="intro__lede">{b.tagline}</p>

      <p class="c-block">
        <strong>{b.street}</strong><br />
        {b.city}, {b.region} {b.postal}
      </p>

      <div class="c-block"><ApptOnly /></div>

      <p class="c-block">
        <a class="c-phone" href={b.phoneHref}>{b.phone}</a>
      </p>

      <div class="cta-row">
        <BookButton label="Book an appointment" />
      </div>
    </div>
  </section>

  <section class="section--wash">
    <div class="page section">
      <div class="two">
        <div class="prose">
          <h2>Before your first visit</h2>
          <p>
            Every appointment is booked in advance — we see one client at a time, so
            there's no waiting and no overlap. Arrive a few minutes early if it's your
            first time so we can go through your skin history without cutting into
            your treatment.
          </p>
          <p>
            Come with clean skin if you can, and bring the products you're currently
            using, or photos of them. Knowing what's already on your skin changes what
            we recommend more than almost anything else.
          </p>
          <p>
            Tell us about any medication, recent treatments, or anything going on with
            your health when you book. Some of it changes what's safe to do that day.
          </p>
        </div>

        <div class="prose">
          <h2>Questions before you book?</h2>
          <p>
            Send a message and we'll get back to you. If it's easier, call
            <a href={b.phoneHref}>{b.phone}</a> — you'll usually reach us between
            appointments.
          </p>

          <form class="form" name="contact" method="POST" action="/thank-you" data-netlify="true" netlify-honeypot="bot-field">
            <input type="hidden" name="form-name" value="contact" />
            <p class="visually-hidden">
              <label>Leave this empty: <input name="bot-field" /></label>
            </p>

            <label class="form__row">
              <span class="form__label">Your name</span>
              <input class="form__input" type="text" name="name" required autocomplete="name" />
            </label>

            <label class="form__row">
              <span class="form__label">Email</span>
              <input class="form__input" type="email" name="email" required autocomplete="email" />
            </label>

            <label class="form__row">
              <span class="form__label">Phone <span class="form__opt">(optional)</span></span>
              <input class="form__input" type="tel" name="phone" autocomplete="tel" />
            </label>

            <label class="form__row">
              <span class="form__label">What can we help with?</span>
              <textarea class="form__input" name="message" rows="5" required></textarea>
            </label>

            <button class="btn" type="submit">Send message</button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <section class="section page">
    <h2>Finding us</h2>
    <div class="find">
      <div class="find__fig">
        <img
          src="/images/storefront-sunset.jpg"
          alt="Avenida de la Estrella at sunset in San Clemente, with the Skin Restore sign visible"
          width="1170" height="1519" loading="lazy"
        />
      </div>
      <div class="prose">
        <p>
          We're on Avenida de la Estrella in downtown San Clemente, a short walk from
          Avenida Del Mar. Look for the Skin Restore name on the building directory.
        </p>
        <p class="find__todo">
          <!-- TODO: add parking guidance, suite number and any entrance detail -->
        </p>
        <p>
          Serving {b.areasServed.slice(0, 4).join(', ')} and greater Orange County.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .intro { display: grid; grid-template-columns: 0.8fr 1fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .intro__fig img { aspect-ratio: 3 / 4; object-fit: cover; width: 100%; border-radius: 4px; }
  .intro__lede {
    font-family: var(--display); font-weight: 400; font-size: var(--t-md);
    color: var(--ink-70); margin-top: var(--s-4); letter-spacing: 0.02em;
  }
  .c-block { font-size: var(--t-base); line-height: 1.8; margin-bottom: var(--s-4); }
  .c-flag { display: block; font-family: var(--display); font-size: var(--t-md); color: var(--marine); letter-spacing: 0.02em; }
  .c-phone { font-family: var(--display); font-size: var(--t-lg); text-decoration: none; }
  .c-phone:hover { text-decoration: underline; }
  .cta-row { display: flex; gap: var(--s-5); flex-wrap: wrap; margin-top: var(--s-5); }

  .two { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 4.5rem); }

  .form { max-width: 28rem; margin-top: var(--s-5); }
  .form__row { display: block; margin-bottom: var(--s-4); }
  .form__label { display: block; font-size: var(--t-sm); margin-bottom: var(--s-2); }
  .form__opt { color: var(--ink-40); }
  .form__input {
    width: 100%; font: inherit; font-size: var(--t-sm); color: var(--ink);
    background: var(--paper); border: 1px solid var(--rule); border-radius: 2px;
    padding: 0.65rem 0.8rem;
  }
  .form__input:focus-visible { border-color: var(--marine); }
  .form textarea.form__input { resize: vertical; }

  .find { display: grid; grid-template-columns: 0.7fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; margin-top: var(--s-5); }
  .find__fig img { aspect-ratio: 4 / 3; object-fit: cover; width: 100%; border-radius: 4px; }
  .find__todo:empty { display: none; }

  @media (max-width: 56rem) {
    .intro, .two, .find { grid-template-columns: 1fr; }
    .intro__fig { max-width: 24rem; }
  }
</style>
