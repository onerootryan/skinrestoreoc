---
import Base from '../layouts/Base.astro';
import BookButton from '../components/BookButton.astro';
import ApptOnly from '../components/ApptOnly.astro';
import { business as b } from '../data/business.js';
import treatments from '../data/treatments.json';
import { reviews } from '../data/reviews.js';
import Review from '../components/Review.astro';

export function getStaticPaths() {
  return treatments.map((t) => ({ params: { slug: t.slug }, props: { t } }));
}

const { t } = Astro.props;
const bySlug = Object.fromEntries(treatments.map((x) => [x.slug, x]));

// Related treatments: from the copy file's link notes, with a sensible fallback
const fallback = ['diamondglow', 'dermaplaning', 'microchanneling'].filter((s) => s !== t.slug);
const related = (t.related.length ? t.related : fallback).slice(0, 3).map((s) => bySlug[s]).filter(Boolean);

const service = { name: t.name, type: t.serviceType, description: t.description };

// Optional client review per treatment — add a key from src/data/reviews.js
const reviewFor = { diamondglow: 'carson' };
const review = reviewFor[t.slug] ? reviews[reviewFor[t.slug]] : null;
---
<Base title={t.title} description={t.description} service={service} faqs={t.faqs}>
  <nav class="page crumbs" aria-label="Breadcrumb">
    <a href="/treatments">Treatments</a><span aria-hidden="true">/</span><span>{t.name}</span>
  </nav>

  <section class="page intro">
    <div class="intro__text">
      <h1>{t.h1}</h1>
      <div class="intro__body prose" set:html={t.intro} />
      <div class="cta-row">
        <BookButton label={`Book ${t.name}`} />
        <a class="tel" href={b.phoneHref}>or call {b.phone}</a>
      </div>
      <div class="intro__appt"><ApptOnly /></div>
    </div>
    <div class="intro__fig">
      <img src={`/images/${t.image}`} alt={t.alt} width="1200" height="1600" fetchpriority="high" />
    </div>
  </section>

  <div class="page body">
    <article class="body__main">
      {t.sections.map((s) => (
        <section class="block">
          <h2>{s.h2}</h2>
          <div class="prose" set:html={s.html} />
        </section>
      ))}
    </article>

    <aside class="body__side" aria-label="Book this treatment">
      <div class="side">
        <p class="side__name">{t.name}</p>
        <p class="side__line">Pricing is confirmed at consultation.</p>
        <BookButton label="Book an appointment" />
        <a class="tel side__tel" href={b.phoneHref}>{b.phone}</a>
        <p class="side__meta">
          <strong>{b.hoursNote}</strong><br />{b.hoursDisplay}<br />{b.street}, {b.city}
        </p>
      </div>
    </aside>
  </div>

  {review && (
    <section class="page section--tight tr-rv">
      <Review r={review} featured />
    </section>
  )}

  {t.faqs.length > 0 && (
    <section class="section--wash">
      <div class="page section">
        <h2>Common questions</h2>
        <div class="faq">
          {t.faqs.map((f) => (
            <details class="faq__item">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section class="section page">
      <h2>Often paired with</h2>
      <ul class="rel">
        {related.map((r) => (
          <li>
            <a class="rel__link" href={`/${r.slug}`}>
              <span class="rel__name">{r.name}</span>
              <span class="rel__desc">{r.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="section--dark">
    <div class="page section closer">
      <h2>Book {t.name} in San Clemente</h2>
      <ApptOnly tone="light" />
      <div class="cta-row">
        <BookButton label="Book an appointment" tone="light" />
        <a class="tel" href={b.phoneHref}>or call {b.phone}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .crumbs { padding-top: var(--s-5); font-size: var(--t-xs); color: var(--ink-40); display: flex; gap: var(--s-2); }
  .crumbs a { color: var(--ink-70); text-decoration: none; }
  .crumbs a:hover { color: var(--marine); text-decoration: underline; }

  .intro { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; padding-block: var(--s-6) var(--s-8); }
  .intro__text h1 { max-width: 16ch; }
  .intro__body { margin-top: var(--s-5); }
  .intro__body :global(p:first-child) { font-family: var(--display); font-size: var(--t-md); color: var(--ink-70); }
  .intro__fig img { aspect-ratio: 3 / 4; object-fit: cover; width: 100%; border-radius: 4px; }
  .intro__appt { margin-top: var(--s-5); }
  .cta-row { display: flex; align-items: center; gap: var(--s-5); flex-wrap: wrap; margin-top: var(--s-5); }

  .body { display: grid; grid-template-columns: minmax(0, 1fr) 17rem; gap: clamp(2rem, 5vw, 4.5rem); padding-bottom: var(--s-8); }
  .block { padding-block: var(--s-6); border-top: 1px solid var(--rule); }
  .block:first-child { border-top: 0; padding-top: 0; }
  .block h2 { font-size: var(--t-lg); margin-bottom: var(--s-4); }
  .block :global(h4), .block :global(strong) { font-weight: 600; }
  .block :global(ul) { max-width: var(--measure); }

  .side { position: sticky; top: 7rem; border: 1px solid var(--rule); border-radius: 6px; padding: var(--s-5); background: var(--paper); box-shadow: 0 1px 2px rgba(22,33,43,.04), 0 8px 24px -12px rgba(22,33,43,.18); }
  .side__name { font-family: var(--display); font-size: var(--t-md); margin: 0 0 var(--s-2); }
  .side__line { font-size: var(--t-sm); color: var(--ink-70); margin-bottom: var(--s-4); }
  .side :global(.btn) { width: 100%; justify-content: center; }
  .side__tel { display: block; text-align: center; margin-top: var(--s-3); }
  .side__meta { font-size: var(--t-xs); color: var(--ink-70); line-height: 1.7; margin: var(--s-5) 0 0; border-top: 1px solid var(--rule); padding-top: var(--s-4); }
  .side__meta strong { color: var(--ink); }

  .faq { margin-top: var(--s-5); border-top: 1px solid var(--sand-d); max-width: 48rem; }
  .faq__item { border-bottom: 1px solid var(--sand-d); }
  .faq__item summary {
    cursor: pointer; list-style: none; padding: var(--s-4) var(--s-6) var(--s-4) 0;
    font-family: var(--display); font-size: var(--t-md); position: relative;
  }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary::after { content: '+'; position: absolute; right: 0; top: var(--s-4); color: var(--marine); font-size: 1.3rem; line-height: 1; }
  .faq__item[open] summary::after { content: '–'; }
  .faq__item p { padding-bottom: var(--s-4); color: var(--ink-70); }

  .rel { list-style: none; padding: 0; margin: var(--s-5) 0 0; max-width: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: var(--s-5); }
  .rel li { margin: 0; }
  .rel__link { display: block; text-decoration: none; color: var(--ink); border-top: 1px solid var(--rule); padding-top: var(--s-4); }
  .rel__name { display: block; font-family: var(--display); font-size: var(--t-md); margin-bottom: var(--s-2); }
  .rel__link:hover .rel__name { color: var(--marine); }
  .rel__desc { display: block; font-size: var(--t-sm); color: var(--ink-70); }

  .closer :global(.appt) { margin-top: var(--s-4); }
  .tr-rv { padding-top: 0; padding-bottom: var(--s-8); }

  @media (max-width: 60rem) {
    .intro { grid-template-columns: 1fr; }
    .intro__fig { order: -1; max-width: 26rem; }
    .body { grid-template-columns: 1fr; }
    .body__side { order: -1; }
    .side { position: static; }
  }
</style>
