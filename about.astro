---
import Base from '../layouts/Base.astro';
import BookButton from '../components/BookButton.astro';
import ApptOnly from '../components/ApptOnly.astro';
import { business as b } from '../data/business.js';
import { reviews } from '../data/reviews.js';
import Review from '../components/Review.astro';

const principles = [
  { h: 'I look before I treat.', p: 'Every appointment starts with an assessment. Skin changes with seasons, stress, hormones and age, and what worked in March may not be right in September.' },
  { h: "I'll tell you the truth about timelines.", p: "Acne takes twelve weeks, not two. Scarring takes a series, not a session. I'd rather you hear that from me at the start than feel let down three appointments in." },
  { h: "I'll tell you when to say no.", p: "If you have cystic acne that needs prescription medication, I'll refer you. If a treatment you've read about isn't right for your skin type, I'll say so. Losing a booking is better than damaging your skin." },
  { h: 'Medical-grade, with clean ingredients.', p: "These aren't mutually exclusive, despite what the industry sometimes suggests. Fifteen years of buying product taught me where that line actually sits." },
  { h: "You'll see me every time.", p: 'Not a rotating roster. Continuity is most of what makes treatment plans work.' },
];
---
<Base
  title="Demi Broughton, Esthetician | Skin Restore"
  description="Demi Broughton — licensed esthetician #Z91680, 15+ years in aesthetics, Paul Mitchell trained, former Skincare Director at Platinum Medical Spa."
>
  <section class="page intro">
    <div class="intro__fig">
      <img src="/images/demi.jpg" alt="Demi Broughton, licensed esthetician and owner of Skin Restore in San Clemente" width="1000" height="1782" fetchpriority="high" />
    </div>
    <div class="intro__text">
      <h1>About Skin Restore</h1>
      <p class="intro__who">{b.practitioner} — {b.credential}, Owner</p>
      <p class="intro__tag">{b.tagline}</p>
    </div>
  </section>

  <div class="page">
    <section class="story">
      <h2>Fifteen years, and one very specific idea about skin</h2>
      <div class="prose">
        <p>
          I trained at Paul Mitchell and earned my California license, and I've spent the
          fifteen years since then doing one thing: looking at skin, figuring out what it
          needs, and doing the work.
        </p>
        <p>
          Most of that time was at <strong>Platinum Medical Spa in Aliso Viejo</strong> — a
          physician-led practice that's been treating Orange County clients since 1998. I
          started there as an esthetician, on the floor, treating clients. Over the years
          that grew into something bigger — I became director of the skincare side of the
          business while continuing to treat clients as head esthetician, and I took on
          product buying and spa direction along the way.
        </p>
        <p>
          That last part matters more than it sounds. Being the buyer meant I spent years
          evaluating product lines on their actual formulations rather than their
          marketing. I saw which ingredients delivered, which brands were selling
          packaging, and what happened to real skin over months and years of use. Very few
          people in this industry get to see both sides of that.
        </p>
      </div>
    </section>

    <section class="story">
      <h2>Why I opened Skin Restore</h2>
      <div class="prose">
        <p>In 2020 I decided to go out on my own.</p>
        <p>
          Running the skincare side of a large med spa taught me an enormous amount, but it
          also showed me what gets lost at scale. Appointments get shorter. Clients get
          moved between providers. Treatment plans start being shaped by what's on
          promotion rather than what the skin in front of you actually needs.
        </p>
        <p>
          I wanted to build somewhere I could do this properly. One esthetician, who knows
          your skin, who sees you every time, who has the time to look at what's changed
          since your last visit and adjust. Somewhere I could carry only the products I'd
          personally put on my own face, and tell you honestly when a treatment isn't right
          for you — including when what you need is a dermatologist rather than me.
        </p>
        <p><strong>That's Skin Restore.</strong></p>
      </div>
    </section>
  </div>

  <figure class="wide">
    <img src="/images/waiting-room.jpg" alt="The waiting room at Skin Restore, San Clemente, with natural light and an ocean view" width="1400" height="1867" loading="lazy" />
  </figure>

  <section class="section page">
    <h2>How I work</h2>
    <ul class="principles">
      {principles.map((x) => (
        <li>
          <h3>{x.h}</h3>
          <p>{x.p}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="page section--tight about-rv">
    <Review r={reviews.amy} featured />
  </section>

  <section class="page section--tight">
    <h2 class="creds-h">Training and credentials</h2>
    <div class="creds">
      <div class="creds__item">
        <span class="creds__n">{b.yearsExperience}</span>
        <span class="creds__l">Years practicing aesthetics in Orange County</span>
      </div>
      <div class="creds__item">
        <span class="creds__n">#{b.licenseNumber}</span>
        <span class="creds__l">Licensed Esthetician, {b.licenseBoard}</span>
      </div>
      <div class="creds__item">
        <span class="creds__n">Paul Mitchell</span>
        <span class="creds__l">Trained, and licensed in California</span>
      </div>
      <div class="creds__item">
        <span class="creds__n">Director</span>
        <span class="creds__l">Former Skincare Director, Head Esthetician, Product Buyer and Spa Director — Platinum Medical Spa, Aliso Viejo</span>
      </div>
    </div>
  </section>

  <section class="section--dark">
    <div class="page section prose closer">
      <h2>Come in and we'll take a look</h2>
      <p>
        If you're not sure what your skin needs, that's the most common reason people book
        — and it's the right reason. Come in, we'll look at it together, and I'll tell you
        what I'd actually do.
      </p>
      <div class="cta-row">
        <BookButton label="Book a consultation" tone="light" />
        <a class="tel" href={b.phoneHref}>or call {b.phone}</a>
      </div>
      <div class="closer__appt"><ApptOnly tone="light" /></div>
    </div>
  </section>
</Base>

<style>
  .intro { display: grid; grid-template-columns: 0.75fr 1fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; padding-block: var(--s-7) var(--s-8); }
  .intro__fig img { aspect-ratio: 4 / 5; object-fit: cover; object-position: center 18%; width: 100%; border-radius: 4px; }
  .intro__who { font-size: var(--t-sm); color: var(--ink-70); margin-top: var(--s-4); letter-spacing: 0.02em; }
  .intro__tag { font-family: var(--display); font-weight: 300; font-size: var(--t-lg); color: var(--marine); margin-top: var(--s-6); max-width: 20ch; }

  .story { display: grid; grid-template-columns: 18rem 1fr; gap: clamp(2rem, 5vw, 4rem); padding-block: var(--s-7); border-top: 1px solid var(--rule); }
  .story h2 { font-size: var(--t-lg); }

  .wide { margin: var(--s-7) 0 0; }
  .wide img { width: 100%; height: clamp(18rem, 45vw, 32rem); object-fit: cover; object-position: center 45%; }

  .principles { list-style: none; padding: 0; margin: var(--s-6) 0 0; max-width: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr)); gap: var(--s-6); }
  .principles li { margin: 0; border-top: 1px solid var(--rule); padding-top: var(--s-4); }
  .principles h3 { font-size: var(--t-md); margin-bottom: var(--s-3); }
  .principles p { font-size: var(--t-sm); color: var(--ink-70); margin: 0; }

  .about-rv { padding-top: 0; }
  .creds-h { font-size: var(--t-lg); margin-bottom: var(--s-5); }

  .cta-row { display: flex; align-items: center; gap: var(--s-5); flex-wrap: wrap; margin-top: var(--s-5); }
  .closer__appt { font-size: var(--t-sm); color: var(--ink-70); margin-top: var(--s-5); }

  @media (max-width: 56rem) {
    .intro, .story { grid-template-columns: 1fr; }
    .intro__fig { max-width: 22rem; }
  }
</style>
