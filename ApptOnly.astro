---
// "By appointment only" — the single, consistent treatment used sitewide.
// tone="light" for use over photography.
import { business as b } from '../data/business.js';
const { hours = true, tone = 'dark' } = Astro.props;
---
<p class={`appt appt--${tone}`}>
  <span class="appt__dot" aria-hidden="true"></span>
  <strong class="appt__label">{b.hoursNote}</strong>
  {hours && <span class="appt__hrs">{b.hoursDisplay}</span>}
</p>

<style>
  .appt {
    display: flex; align-items: center; flex-wrap: wrap; gap: 0.35rem 0.65rem;
    margin: 0; max-width: none;
  }
  /* The dot echoes the logo's dot grid */
  .appt__dot {
    width: 0.6rem; height: 0.6rem; border-radius: 50%;
    background: var(--marine); flex: none;
  }
  .appt__label {
    font-family: var(--display); font-weight: 600;
    font-size: var(--t-md); letter-spacing: 0.01em; color: var(--marine);
  }
  .appt__hrs { font-size: var(--t-sm); color: var(--ink-70); }

  .appt--light .appt__dot   { background: #fff; }
  .appt--light .appt__label { color: #fff; }
  .appt--light .appt__hrs   { color: rgba(255,255,255,.85); }
</style>
