---
import Base from '../layouts/Base.astro';
import BookButton from '../components/BookButton.astro';
import ApptOnly from '../components/ApptOnly.astro';
import { business as b } from '../data/business.js';
import { reviews } from '../data/reviews.js';
import Review from '../components/Review.astro';

// Three signature treatments, showcased with photos (swap freely)
const signature = [
  { href: '/diamondglow', name: 'DiamondGlow', img: 'diamondglow.jpg',
    line: 'Exfoliate, extract and infuse in a single pass. Brighter skin walking out the door, with no downtime.' },
  { href: '/microchanneling', name: 'Micro Channeling', img: 'microchanneling.jpg',
    line: 'Also called nano needling — stimulates your own collagen for firmer skin and smoother texture. Results build over a series.' },
  { href: '/biorepeel', name: 'BioRePeel', img: 'biorepeel.jpg',
    line: 'The renewal of a TCA-strength peel, with minimal visible peeling. Keep your plans.' },
];
const mapsUrl = 'https://www.google.com/maps/search/?api=1&query=' +
  encodeURIComponent(`${b.street}, ${b.city}, ${b.region} ${b.postal}`);

const treatments = [
  { href: '/diamondglow', name: 'DiamondGlow', line: 'Exfoliate, extract and infuse in a single treatment. Brighter skin, no downtime.' },
  { href: '/microchanneling', name: 'Micro Channeling', line: 'Also called nano needling. Stimulates your own collagen for firmer skin and smoother texture.' },
  { href: '/rf-skin-tightening', name: 'Wonder Touch RF', line: 'Radiofrequency energy to lift and firm without surgery or downtime.' },
  { href: '/oxygen-facial', name: 'BREEZE Cryo Oxygen', line: 'Needle-free hydration and nutrient infusion. Nothing touches your skin but air.' },
  { href: '/cryo-facial', name: 'Cool Restore Cryo', line: 'Controlled cooling to firm, de-puff and calm. Book it before an event.' },
  { href: '/teen-facial', name: 'Teen Facial', line: 'A proper professional treatment for teenage skin, with safe extractions.' },
  { href: '/dermaplaning', name: 'DermaPlane', line: 'Removes dead skin and fine vellus hair for an instantly smoother finish.' },
  { href: '/chemical-peels', name: 'Chemical Peels', line: 'Mild to moderate peels for tone, texture and pigmentation.' },
  { href: '/biorepeel', name: 'BioRePeel', line: 'A TCA-strength peel with minimal visible peeling.' },
];
---
<Base
  overlayNav
  title="San Clemente Med Spa & Medical-Grade Facials"
  description="Medical-grade facials, microchanneling and RF skin tightening in San Clemente, CA. Fifteen years' experience and one licensed esthetician, every visit."
>
  <!-- Hero: full-screen photo, transparent header over it -->
  <section class="hero">
    <img class="hero__img" src="/images/spa-hall.jpg"
      alt="The hallway at Skin Restore, San Clemente, looking toward the back window and balcony with palms beyond"
      width="1200" height="1836" fetchpriority="high" />
    <div class="hero__scrim"></div>
    <div class="page hero__inner">
      <h1>Medical-grade skin care in San&nbsp;Clemente</h1>
      <p class="hero__tag">{b.tagline}</p>
      <div class="hero__appt"><ApptOnly tone="light" /></div>
      <div class="hero__cta">
        <BookButton label="Book an appointment" tone="light" />
        <a class="btn btn--ghost-light" href="/treatments">Explore treatments</a>
      </div>
    </div>
  </section>

  <!-- Why -->
  <section class="section page why">
    <div class="why__cols">
      <figure class="why__fig">
        <img src="/images/demi.jpg" alt="Demi Broughton, licensed esthetician and owner of Skin Restore" width="1000" height="1782" loading="lazy" />
        <figcaption>Demi Broughton · Licensed Esthetician #Z91680</figcaption>
      </figure>
      <div class="prose why__text">
        <h2>You'll see the same person every time</h2>
        <p class="why__lede">
          Most med spas rotate you between providers. Your treatment plan gets handed
          off, your history gets re-explained, and the person holding the wand has never
          seen your skin before.
        </p>
        <p>That isn't how this works.</p>
        <p>
          Skin Restore is one licensed esthetician with fifteen years behind her,
          including years running the skincare side of an established Orange County
          medical spa. Every appointment starts with a proper look at what your skin is
          doing right now — because skin changes with seasons, stress, hormones and age,
          and what worked in March may be wrong in September.
        </p>
        <p>
          We use medical-grade products with clean ingredients, and we'll tell you
          honestly when a treatment isn't right for you. Sometimes that means
          recommending something cheaper. Sometimes it means sending you to a
          dermatologist.
        </p>
        <p><a class="btn btn--quiet" href="/about">Meet Demi</a></p>
      </div>
    </div>
  </section>

  <!-- Signature treatments: photo-led -->
  <section class="section page sig">
    <div class="sig__head">
      <h2>Signature treatments</h2>
      <a class="sig__all" href="/treatments">All treatments</a>
    </div>
    <div class="sig__grid">
      {signature.map((t) => (
        <article class="sig__card">
          <a class="sig__media" href={t.href} tabindex="-1" aria-hidden="true">
            <img src={`/images/${t.img}`} alt="" width="1200" height="1600" loading="lazy" />
          </a>
          <h3 class="sig__name"><a href={t.href}>{t.name}</a></h3>
          <p class="sig__line">{t.line}</p>
          <div class="sig__actions">
            <a class="sig__more" href={t.href}>Learn more</a>
            <BookButton label="Book" quiet />
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Full menu -->
  <section class="section--wash">
    <div class="page section">
      <h2>The full menu</h2>
      <ul class="tlist">
        {treatments.map((t) => (
          <li class="tlist__item">
            <a class="tlist__link" href={t.href}>
              <h3 class="tlist__name">{t.name}</h3>
              <p class="tlist__line">{t.line}</p>
              <span class="tlist__go" aria-hidden="true">&rarr;</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Proof: dark band -->
  <section class="section--dark">
    <div class="page section">
      <h2>What clients say</h2>
      <div class="reviews">
        <div class="reviews__feature"><Review r={reviews.mallory} featured /></div>
        <div class="reviews__pair">
          <Review r={reviews.tessa} />
          <Review r={reviews.kelly} />
        </div>
      </div>
      <div class="creds proof__creds">
        <div class="creds__item">
          <span class="creds__n">{b.yearsExperience}</span>
          <span class="creds__l">Years practicing aesthetics in Orange County</span>
        </div>
        <div class="creds__item">
          <span class="creds__n">#{b.licenseNumber}</span>
          <span class="creds__l">Licensed Esthetician, {b.licenseBoard}</span>
        </div>
        <div class="creds__item">
          <span class="creds__n">Director</span>
          <span class="creds__l">Former Skincare Director, Platinum Medical Spa, Aliso Viejo</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Products -->
  <section class="section page shop">
    <div class="prose">
      <h2>Medical-grade products, chosen not stocked</h2>
      <p>
        We carry a small, deliberate range of medical-grade skincare — selected after
        fifteen years of evaluating formulations rather than marketing. Whatever we use
        in the treatment room, you can continue at home. That's most of what determines
        your results between visits.
      </p>
      {b.shopLive
        ? <p><a class="btn btn--quiet" href={b.shopUrl}>Shop skincare</a></p>
        : <p class="shop__ask">Ask about the right products for your skin at your next appointment.</p>}
    </div>
  </section>

  <!-- Visit: full-width photo band -->
  <section class="visit">
    <img class="visit__img" src="/images/storefront-sunset.jpg"
      alt="Avenida de la Estrella at sunset in San Clemente, with the Skin Restore sign"
      width="1170" height="1519" loading="lazy" />
    <div class="visit__scrim"></div>
    <div class="page visit__inner">
      <h2>Visit us in downtown San Clemente</h2>
      <p class="visit__addr">{b.street}<br />{b.city}, {b.region} {b.postal}</p>
      <div class="visit__appt"><ApptOnly tone="light" /></div>
      <div class="visit__cta">
        <BookButton label="Book an appointment" tone="light" />
        <a class="btn btn--ghost-light" href={mapsUrl} target="_blank" rel="noopener">Get directions</a>
      </div>
      <p class="visit__tel"><a href={b.phoneHref}>{b.phone}</a></p>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero { position: relative; min-height: clamp(36rem, 94vh, 58rem); display: flex; align-items: flex-end; }
  .hero__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 44%; }
  .hero__scrim {
    position: absolute; inset: 0;
    background:
      linear-gradient(to bottom, rgba(14,24,33,.55) 0%, rgba(14,24,33,0) 24%),
      linear-gradient(to top, rgba(14,24,33,.78) 0%, rgba(14,24,33,.32) 45%, rgba(14,24,33,0) 75%);
  }
  .hero__inner { position: relative; padding-block: clamp(3rem, 8vw, 6rem); width: 100%; }
  .hero__inner h1 { color: #fff; max-width: 14ch; font-size: clamp(2.8rem, 1.6rem + 4.6vw, 5.4rem); line-height: 1.02; }
  .hero__tag { font-family: var(--display); font-weight: 300; color: rgba(255,255,255,.92); font-size: var(--t-md); letter-spacing: .04em; margin: var(--s-4) 0 0; }
  .hero__appt { margin-top: var(--s-5); }
  .hero__cta { display: flex; align-items: center; gap: var(--s-4); flex-wrap: wrap; margin-top: var(--s-6); }

  /* Why */
  .why__cols { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1fr); gap: clamp(2rem, 6vw, 5.5rem); align-items: center; }
  .why__fig { margin: 0; }
  .why__fig img { aspect-ratio: 4 / 5; object-fit: cover; object-position: center 18%; width: 100%; border-radius: 4px; }
  .why__fig figcaption { font-size: var(--t-xs); color: var(--ink-70); margin-top: var(--s-3); letter-spacing: .04em; }
  .why__text h2 { margin-bottom: var(--s-5); }
  .why__lede { font-family: var(--display); font-size: var(--t-md); color: var(--ink); }

  /* Signature */
  .sig__head { display: flex; justify-content: space-between; align-items: baseline; gap: var(--s-4); flex-wrap: wrap; }
  .sig__all { font-size: var(--t-sm); }
  .sig__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1.25rem, 3vw, 2.5rem); margin-top: var(--s-6); }
  .sig__card { display: flex; flex-direction: column; }
  .sig__media { display: block; overflow: hidden; border-radius: 4px; }
  .sig__media img { aspect-ratio: 4 / 5; object-fit: cover; width: 100%; transition: transform .6s ease; }
  .sig__card:hover .sig__media img { transform: scale(1.035); }
  .sig__name { font-size: var(--t-lg); margin: var(--s-5) 0 var(--s-2); }
  .sig__name a { color: var(--ink); text-decoration: none; }
  .sig__name a:hover { color: var(--marine); }
  .sig__line { font-size: var(--t-sm); color: var(--ink-70); flex: 1; }
  .sig__actions { display: flex; align-items: center; gap: var(--s-5); margin-top: var(--s-4); }
  .sig__more { font-size: var(--t-sm); font-weight: 500; }

  /* Full menu */
  .tlist { list-style: none; padding: 0; margin: var(--s-6) 0 0; max-width: none; border-top: 1px solid var(--rule); }
  .tlist__item { margin: 0; border-bottom: 1px solid var(--rule); }
  .tlist__link {
    display: grid; grid-template-columns: 16rem 1fr auto; gap: var(--s-5);
    padding-block: var(--s-4); text-decoration: none; color: var(--ink); align-items: baseline;
    transition: padding-left .2s ease;
  }
  .tlist__link:hover { padding-left: var(--s-2); }
  .tlist__link:hover .tlist__name, .tlist__link:hover .tlist__go { color: var(--marine); }
  .tlist__name { font-size: var(--t-md); }
  .tlist__line { font-size: var(--t-sm); color: var(--ink-70); margin: 0; max-width: 52ch; }
  .tlist__go { color: var(--ink-40); font-size: 1.1rem; }

  /* Proof band */
  .reviews { margin-top: var(--s-6); display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: start; }
  .reviews__pair { display: grid; gap: var(--s-6); }
  .proof__creds { margin-top: var(--s-8); }

  /* Products */
  .shop__ask { font-family: var(--display); font-size: var(--t-md); color: var(--marine); }

  /* Visit band */
  .visit { position: relative; min-height: clamp(28rem, 70vh, 42rem); display: flex; align-items: flex-end; }
  .visit__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 55%; }
  .visit__scrim { position: absolute; inset: 0; background: linear-gradient(to top, rgba(14,24,33,.82) 0%, rgba(14,24,33,.4) 50%, rgba(14,24,33,.1) 100%); }
  .visit__inner { position: relative; width: 100%; padding-block: clamp(3rem, 7vw, 5rem); }
  .visit__inner h2 { color: #fff; max-width: 18ch; }
  .visit__addr { color: rgba(255,255,255,.9); font-size: var(--t-md); line-height: 1.6; margin-top: var(--s-4); }
  .visit__appt { margin-top: var(--s-4); }
  .visit__cta { display: flex; gap: var(--s-4); flex-wrap: wrap; margin-top: var(--s-5); }
  .visit__tel { margin-top: var(--s-4); }
  .visit__tel a { color: rgba(255,255,255,.85); text-decoration: none; font-size: var(--t-sm); }
  .visit__tel a:hover { color: #fff; text-decoration: underline; }

  @media (max-width: 56rem) {
    .why__cols { grid-template-columns: 1fr; }
    .why__fig { max-width: 22rem; }
    .sig__grid { grid-template-columns: 1fr; }
    .sig__media img { aspect-ratio: 16 / 11; }
    .tlist__link { grid-template-columns: 1fr auto; gap: var(--s-2); }
    .tlist__line { grid-column: 1; }
    .tlist__go { grid-column: 2; grid-row: 1; }
    .reviews { grid-template-columns: 1fr; }
  }
</style>
