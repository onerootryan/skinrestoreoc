---
import Base from '../layouts/Base.astro';
import BookButton from '../components/BookButton.astro';
import ApptOnly from '../components/ApptOnly.astro';
import { business as b } from '../data/business.js';

// A starting point for "facial near me" searches: helps a first-time client
// pick a facial, then hands off to the individual treatment pages.
const choices = [
  { href: '/diamondglow', name: 'DiamondGlow',
    when: 'You want brighter, cleaner-looking skin with no downtime, or you are not sure where to start.' },
  { href: '/oxygen-facial', name: 'BREEZE Cryo Oxygen',
    when: 'Your skin feels dry, tired or dull and you want a calm, hydrating treatment.' },
  { href: '/cryo-facial', name: 'Cool Restore Cryo',
    when: 'You have an event coming up and want skin to look firmer, calmer and less puffy.' },
  { href: '/dermaplaning', name: 'DermaPlane',
    when: 'Texture and peach fuzz bother you, or makeup does not sit smoothly.' },
  { href: '/chemical-peels', name: 'Chemical Peels',
    when: 'Uneven tone, dark spots or rough texture are the main concern.' },
  { href: '/rf-skin-tightening', name: 'Wonder Touch RF',
    when: 'Skin has started to look less firm along the jaw, cheeks or neck.' },
  { href: '/teen-facial', name: 'Teen Facial',
    when: 'A teenager needs a professional clean-up and a simple routine to follow at home.' },
];

const faqs = [
  { q: 'Which facial should I book for my first visit?',
    a: 'If you are unsure, book DiamondGlow or a consultation. Demi looks at your skin first and will suggest a different treatment on the day if another one suits you better.' },
  { q: 'Is there downtime after a facial?',
    a: 'Most of our facials have none, and you can go straight back to your day. Chemical peels and micro channeling can mean a few days of flaking or redness; you will be told before the treatment starts.' },
  { q: 'How often should I get a facial?',
    a: 'Every four to six weeks suits most people, because that is roughly how long skin takes to renew its surface. Some treatments, like peels and RF, work best as a short series.' },
  { q: 'Will I see the same person each time?',
    a: 'Yes. Every treatment is performed by Demi Broughton, a licensed esthetician with more than 15 years of experience.' },
  { q: 'Where are you located?',
    a: 'At 312 Avenida de la Estrella in San Clemente, about ten minutes from Dana Point and San Juan Capistrano. Appointments are Tuesday to Saturday, 10am to 6pm, and booking ahead is required.' },
];

const service = {
  name: 'Facials',
  type: 'Facial treatment',
  description: 'Facials in San Clemente, CA, performed by a licensed esthetician: DiamondGlow, oxygen and cryo facials, dermaplaning, chemical peels, RF skin tightening and teen facials.',
};
---
<Base
  title="Facials in San Clemente, CA | Skin Restore"
  description="Facials in San Clemente by a licensed esthetician with 15+ years of experience: DiamondGlow, oxygen and cryo facials, and peels. Near Dana Point and SJC."
  service={service}
  faqs={faqs}
>
  <nav class="page crumbs" aria-label="Breadcrumb">
    <a href="/treatments">Treatments</a><span aria-hidden="true">/</span><span>Facials</span>
  </nav>

  <section class="page intro">
    <div class="intro__text">
      <p class="intro__loc">{b.city}, CA</p>
      <h1>Facials</h1>
      <div class="intro__body prose">
        <p>A facial here starts with a close look at your skin, not a menu.</p>
        <p>
          Every appointment is with Demi Broughton, a licensed esthetician with more than
          15 years of experience. She checks what your skin is doing that day, then
          chooses and adjusts the treatment to match, so the same visit can look quite
          different for two people.
        </p>
        <p>
          Skin Restore is in San Clemente and sees clients from Dana Point,
          San Juan Capistrano and Laguna Niguel.
        </p>
      </div>
      <div class="cta-row">
        <BookButton label="Book a facial" />
        <a class="tel" href={b.phoneHref}>or call {b.phone}</a>
      </div>
      <div class="intro__appt"><ApptOnly /></div>
    </div>
    <div class="intro__fig">
      <img
        src="/images/treatment-room.jpg"
        alt="The treatment room at Skin Restore in San Clemente, with a treatment bed, magnifying lamp and equipment"
        width="1200" height="1600" fetchpriority="high"
      />
    </div>
  </section>

  <section class="section--wash">
    <div class="page section">
      <h2>Which facial is right for you</h2>
      <p class="lead">Start with the concern that bothers you most. Demi will confirm the choice once she has seen your skin.</p>
      <ul class="tlist">
        {choices.map((c) => (
          <li class="tlist__item">
            <a class="tlist__link" href={c.href}>
              <h3 class="tlist__name">{c.name}</h3>
              <p class="tlist__line">{c.when}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section page prose">
    <h2>What every facial includes</h2>
    <ul>
      <li>A skin assessment and a short conversation about what you want to change.</li>
      <li>Cleansing and preparation suited to your skin type.</li>
      <li>The treatment itself, adjusted to how your skin looks on the day.</li>
      <li>Simple aftercare advice and, if useful, a plan for your next visits.</li>
    </ul>
    <h2>Pricing</h2>
    <p>
      Pricing is confirmed at your consultation, once the treatment and any add-ons are
      agreed. Call <a href={b.phoneHref}>{b.phone}</a> to talk it through.
    </p>
  </section>

  <section class="section--wash">
    <div class="page section">
      <h2>Common questions</h2>
      <div class="faq">
        {faqs.map((f) => (
          <details class="faq__item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section--dark">
    <div class="page section closer">
      <h2>Book a facial in San Clemente</h2>
      <ApptOnly tone="light" />
      <div class="cta-row">
        <BookButton label="Book an appointment" tone="light" />
        <a class="tel" href={b.phoneHref}>or call {b.phone}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .crumbs { padding-top: var(--s-5); font-size: var(--t-xs); color: var(--ink-40); display: flex; gap: var(--s-2); }
  .crumbs a { color: var(--ink-70); text-decoration: none; }
  .crumbs a:hover { color: var(--marine); text-decoration: underline; }

  .intro { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; padding-block: var(--s-6) var(--s-8); }
  .intro__loc { font-size: var(--t-xs); letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-40); margin: 0 0 var(--s-3); }
  .intro__body { margin-top: var(--s-5); }
  .intro__body :global(p:first-child) { font-family: var(--display); font-size: var(--t-md); color: var(--ink-70); }
  .intro__fig img { aspect-ratio: 3 / 4; object-fit: cover; width: 100%; border-radius: 4px; }
  .intro__appt { margin-top: var(--s-5); }
  .cta-row { display: flex; align-items: center; gap: var(--s-5); flex-wrap: wrap; margin-top: var(--s-5); }

  .lead { color: var(--ink-70); max-width: var(--measure); margin-top: var(--s-3); }
  .tlist { list-style: none; padding: 0; margin: var(--s-6) 0 0; max-width: none; border-top: 1px solid var(--rule); }
  .tlist__item { margin: 0; border-bottom: 1px solid var(--rule); }
  .tlist__link { display: grid; grid-template-columns: 16rem 1fr; gap: var(--s-5); padding-block: var(--s-4); text-decoration: none; color: var(--ink); align-items: baseline; }
  .tlist__link:hover .tlist__name { color: var(--marine); }
  .tlist__name { font-size: var(--t-md); }
  .tlist__line { font-size: var(--t-sm); color: var(--ink-70); margin: 0; max-width: 56ch; }

  .faq { margin-top: var(--s-5); border-top: 1px solid var(--sand-d); max-width: 48rem; }
  .faq__item { border-bottom: 1px solid var(--sand-d); }
  .faq__item summary { cursor: pointer; list-style: none; padding: var(--s-4) var(--s-6) var(--s-4) 0; font-family: var(--display); font-size: var(--t-md); position: relative; }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary::after { content: '+'; position: absolute; right: 0; top: var(--s-4); color: var(--marine); font-size: 1.3rem; line-height: 1; }
  .faq__item[open] summary::after { content: '–'; }
  .faq__item p { padding-bottom: var(--s-4); color: var(--ink-70); }

  .closer :global(.appt) { margin-top: var(--s-4); }

  @media (max-width: 60rem) {
    .intro { grid-template-columns: 1fr; }
    .intro__fig { order: -1; max-width: 26rem; }
    .tlist__link { grid-template-columns: 1fr; gap: var(--s-2); }
  }
</style>
